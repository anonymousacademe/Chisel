{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chisel",
  "version": "0.2.0",
  "identifier": "io.github.anonymousacademe.chisel",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Chisel",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#121318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}